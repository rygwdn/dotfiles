#!/usr/bin/env bun
import { spawn } from "node:child_process";
import { realpathSync } from "node:fs";
import { dirname, join } from "node:path";

// Resolve through ~/dotfiles/bin's symlink so modules never depend on the launch cwd.
const root = dirname(dirname(realpathSync(process.argv[1])));
const { config, initialize, load } = await import(join(root, "omp/secrets/store.ts"));
const [action, ...args] = process.argv.slice(2);
try {
  const cfg = config();
  if (action === "hermes") {
    const escapeNewlines = args.length === 1 && args[0] === "--escape-newlines";
    if ((args.length && !escapeNewlines) || process.env.HERMES_SECRET_KEY) throw new Error("Hermes adapter supports bulk export only");
    const { values } = await load(cfg);
    // Hermes strips one quote layer, but does not decode escapes or multiline values.
    // Validate the complete blob before writing anything; never emit a partial store.
    const lines = Object.entries(values).map(([name, value]) => {
      if (!value.trim() || (!escapeNewlines && /[\r\n]/.test(value))) throw new Error("Store contains values unsupported by the Hermes dotenv protocol");
      // Escape slashes first so literal backslash-n cannot collide with an LF.
      const encoded = escapeNewlines ? value.replaceAll("\\", "\\\\").replaceAll("\r", "\\r").replaceAll("\n", "\\n") : value;
      return `${name}='${encoded}'\n`;
    });
    const output = lines.join("");
    if (Buffer.byteLength(output, "utf8") > 1024 * 1024) throw new Error("Hermes adapter output exceeds 1 MiB");
    process.stdout.write(output);
  } else if (action === "init") {
    if (args.length) throw new Error("Usage: omp-secrets init");
    await initialize(cfg);
    console.log(`Offline identity ready: ${cfg.identity}`);
  } else if (action === "sync" || action === "status") {
    if (args.length) throw new Error(`Usage: omp-secrets ${action}`);
    const { catalog } = await load(cfg, action === "sync");
    console.log(JSON.stringify(catalog, null, 2));
  } else if (action === "run") {
    if (args[0] === "--") args.shift();
    const { values, catalog } = await load(cfg);
    if (catalog.source === "cache") console.error(`omp-secrets: using encrypted offline snapshot from ${catalog.cachedAt}`);
    // A nested launch must not retain deleted or rotated catalog credentials.
    const inherited = Object.fromEntries(Object.entries(process.env).filter(([name]) => !name.startsWith("OMP_SECRET_")));
    const child = spawn(process.env.OMP_SECRETS_OMP ?? "omp", [
      "--config", join(root, "omp/secrets/redaction.yml"),
      ...args,
    ], { stdio: "inherit", env: {
      ...inherited, ...values,
      OMP_SECRETS_READY: "1", OMP_SECRETS_CATALOG: JSON.stringify(catalog),
    } });
    for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"] as const) process.on(signal, () => child.kill(signal));
    child.on("error", () => { console.error("omp-secrets: cannot start OMP"); process.exitCode = 1; });
    child.on("exit", (code, signal) => { process.exitCode = code ?? (signal === "SIGINT" ? 130 : 1); });
  } else {
    throw new Error("Usage: omp-secrets {init|sync|status|hermes [--escape-newlines]|run [--] [OMP arguments]}\nSet OMP_SECRETS_OFFLINE=1 to use the encrypted cache without SSH.");
  }
} catch (error) {
  // Adapter diagnostics must never include paths, input, values, or subprocess output.
  console.error(action === "hermes" ? "omp-secrets: Hermes bulk export failed" : `omp-secrets: ${error instanceof Error ? error.message : "operation failed"}`);
  process.exitCode = 1;
}
