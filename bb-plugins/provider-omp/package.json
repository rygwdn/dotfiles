{
  "name": "bb-plugin-provider-omp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run bb threads through oh-my-pi's native RPC.",
  "homepage": "https://github.com/can1357/oh-my-pi",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.5.22"
  },
  "bb": {
    "name": "omp (RPC) provider",
    "description": "Run bb threads through oh-my-pi's native RPC.",
    "branding": {
      "icon": "./icons/omp.svg"
    },
    "server": "./server.ts",
    "host": "./src/host.ts",
    "app": "./app.tsx",
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "omp",
        "displayName": "omp (RPC)"
      }
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist ."
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@radix-ui/react-slot": "^1.3.0",
    "jsonc-parser": "^3.3.1",
    "which-command": "0.1.0",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "4.11.9",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0",
    "typebox": "1.3.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  }
}
