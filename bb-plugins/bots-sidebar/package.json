{
  "name": "bb-plugin-bots-sidebar",
  "version": "1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rygwdn/bb-bots-sidebar.git"
  },
  "scripts": {
    "vendor:check": "node scripts/update-thread-list.mjs --check",
    "vendor:update": "node scripts/update-thread-list.mjs",
    "prepare:thread-list": "node scripts/prepare-thread-list.mjs",
    "pretest": "npm run prepare:thread-list",
    "pretypecheck": "npm run prepare:thread-list",
    "prebuild": "npm run vendor:check && npm run prepare:thread-list",
    "test": "vitest run",
    "pretest:thread-list": "npm run prepare:thread-list",
    "test:thread-list": "vitest run --config vitest.thread-list.config.ts",
    "prepare": "npm run prepare:thread-list",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build"
  },
  "engines": {
    "bb": ">=0.46.1",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Bots Sidebar",
    "description": "Keep specialist bots, their memory, and their conversations together across projects.",
    "branding": {
      "icon": "./assets/bot.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-compose-refs": "1.1.3",
    "@radix-ui/react-slot": "^1.3.0",
    "jotai": "2.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "29.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "4.1.11"
  }
