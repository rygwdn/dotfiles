{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "*.ts",
    "*.tsx",
    "generated",
    "components",
    "lib",
    "hooks"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "bundle-extension.ts"]
}
